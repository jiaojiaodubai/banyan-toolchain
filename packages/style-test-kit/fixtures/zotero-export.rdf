  <!-- A standalone note: unlike a child note, Zotero gives it a z:itemType. -->
  <bib:Memo rdf:about="#item_6">
    <z:itemType>note</z:itemType>
    <rdf:value>&lt;p&gt;A standalone note.&lt;/p&gt;</rdf:value>
    <dc:subject>standalone-tag</dc:subject>
  </bib:Memo>

  <!--
    Zotero uses the item URL as the RDF subject when the item has no ISBN and
    the URL is not already taken, so referencing it needs the URL, not
    `#item_N`.
  -->
  <bib:Document rdf:about="https://example.org/webpage">
    <z:itemType>webpage</z:itemType>
    <dc:title>Example page</dc:title>
    <dc:identifier>
      <dcterms:URI>
        <rdf:value>https://example.org/webpage</rdf:value>
      </dcterms:URI>
    </dc:identifier>
    <dcterms:isPartOf>
      <z:Website>
        <dc:title>Example site</dc:title>
      </z:Website>
    </dcterms:isPartOf>
    <bib:authors>
      <rdf:Seq>
        <rdf:li>
          <foaf:Person>
            <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
            <foaf:surname>Doe</foaf:surname>
            <foaf:givenName>Jane</foaf:givenName>
          </foaf:Person>
        </rdf:li>
      </rdf:Seq>
    </bib:authors>
  </bib:Document>
</rdf:RDF>
