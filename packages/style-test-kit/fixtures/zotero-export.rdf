          </foaf:Person>
        </rdf:li>
      </rdf:Seq>
    </bib:editors>
  </bib:Book>

  <rdf:Description rdf:about="#item_5">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>数字图书馆的语义互操作</dc:title>
    <dcterms:isPartOf>
      <bib:Journal>
        <dc:title>会议论文集</dc:title>
        <prism:number>C1</prism:number>
      </bib:Journal>
    </dcterms:isPartOf>
    <bib:presentedAt>
      <bib:Conference>
        <dc:title>第十二届中国数字图书馆建设与发展研讨会</dc:title>
      </bib:Conference>
    </bib:presentedAt>
    <bib:authors>
      <rdf:Seq>
        <rdf:li>
          <foaf:Person>
            <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
            <foaf:surname>赵</foaf:surname>
            <foaf:givenName>一</foaf:givenName>
          </foaf:Person>
        </rdf:li>
      </rdf:Seq>
    </bib:authors>
  </rdf:Description>

  <z:Collection rdf:about="#collection_1">
    <dc:title>Reading list</dc:title>
    <dcterms:hasPart rdf:resource="#item_1"/>
    <dcterms:hasPart rdf:resource="#item_4"/>
